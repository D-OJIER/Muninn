# Copy to .env and fill in from Firebase console > Project settings > Your apps (Web app).
# These values identify your Firebase project; they are not secrets, but .env is gitignored anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check debug token (Firebase console > Security > App Check > Apps > Manage debug tokens).
# Leave empty on first run: the side panel console will print a new token to register.
# Never commit a real token.
VITE_APPCHECK_DEBUG_TOKEN=

# Cloud model used when no on-device model is available.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
