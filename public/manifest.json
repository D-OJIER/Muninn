{
  "manifest_version": 3,
  "name": "Muninn",
  "version": "0.1.0",
  "description": "Read between the lines, without anyone reading yours.",
  "minimum_chrome_version": "139",
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Muninn"
  }
}
